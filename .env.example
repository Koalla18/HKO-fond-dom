# База PostgreSQL
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dom_inbox

# Ключ шифрования паролей и токенов каналов (32 байта в base64).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ВНИМАНИЕ: смена ключа сделает сохранённые токены каналов нечитаемыми.
APP_SECRET=

# Публичный адрес платформы — на него площадки шлют вебхуки (Telegram, ВК Callback, Instagram).
# Пока сервер по IP без HTTPS: http://<ip>:3050 — работают почта, ВК (Long Poll), Telegram (опрос), MAX, сайт.
APP_URL=http://localhost:3050

# Первый администратор (создаётся при первом запуске, если сотрудников ещё нет)
ADMIN_EMAIL=admin@dom.local
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# off — не запускать опрос каналов (например, на втором экземпляре)
CONNECTORS=on

# Для docker-compose: пароль встроенной базы
POSTGRES_PASSWORD=
